{
  "name": "wikimd",
  "version": "1.0.0",
  "private": true,
  "description": "WikiMD compiler and VS Code extension.",
  "main": "wmd-compiler.js",
  "bin": {
    "wmd": "./wmd-compiler.js"
  },
  "scripts": {
    "build": "node ./wmd-compiler.js",
    "compile": "node ./wmd-compiler.js",
    "watch": "node ./wmd-compiler.js --watch",
    "serve": "node ./wmd-compiler.js --serve",
    "test": "node --test",
    "check": "node --check wmd-compiler.js && node --check vscode-extension/extension.js && node --test"
  },
  "keywords": [
    "markdown",
    "wiki",
    "wikimd",
    "wmd"
  ],
  "author": "Remy Ellis",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "markdown-it": "^14.3.0"
  }
}
